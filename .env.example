# -----------------------------------------------------------------------------
# Devity Frontend (Vite) — пример окружения
# Скопируйте: cp .env.example .env
# После изменений перезапустите dev-сервер или пересоберите Docker-образ.
# -----------------------------------------------------------------------------

# Базовый URL API Laravel (без завершающего слэша; суффикс /api обязателен)
# Docker backend (docker-compose): http://localhost:8080/api
# Локальный php artisan serve:     http://localhost:8000/api
VITE_APP_BACKEND=http://localhost:8080/api

# Laravel Echo + Reverb (должны совпадать с REVERB_* на бэкенде)
# Хост/порт с точки зрения браузера (на машине разработчика — 127.0.0.1 и порт из docker-compose reverb)
VITE_WS_HOST=127.0.0.1
VITE_WS_PORT=8081
VITE_WS_TLS=false
VITE_WS_APP_KEY=devity-key

# Доступ с другого устройства в сети (пример):
# VITE_APP_BACKEND=http://192.168.0.10:8080/api
# VITE_WS_HOST=192.168.0.10
# VITE_WS_PORT=8081
